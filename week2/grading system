public class GradingSystem {

    public static String classifyMark(int mark) {

        if (mark >= 80 && mark <= 100) {
            return "Distinction";
        }
        else if (mark >= 70 && mark < 80) {
            return "Merit";
        }
        else if (mark >= 50 && mark < 70) {
            return "Pass";
        }
        else if (mark >=0 && mark < 50) {
            return "Fail";
        }
        else {
            return "Invalid mark";
        }
    }
}
